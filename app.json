{
  "expo": {
    "name": "Notes",
    "slug": "Notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        //"backgroundColor": "#141414",
        "foregroundImage": "./assets/ic_launcher_foreground.png",
        "backgroundImage": "./assets/ic_launcher_background.png",
        "monochromeImage": "./assets/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.notes",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      [
        "./plugins/withAndroidExternalNativeBuild",
        {
          "cmakeVersion": "4.1.2"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141414",
          "image": "./assets/ic_launcher.png",
          /* "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }, */
          "imageWidth": 200
        }
      ]
    ]
  }
}
